# Copy to .env for local Docker Compose development.
# Replace these placeholders before use. Never use them for production.

POSTGRES_PASSWORD=container-dev-only-change-me
CONTAINER_ENVIRONMENT=development
CONTAINER_JWT_SECRET=container-development-secret-change-before-deploy
CONTAINER_ARTIFACTS_PATH=./artifacts
CONTAINER_MAX_ARTIFACT_BYTES=104857600
CONTAINER_WORKER_POLL_SECONDS=1

# Optional OpenAI-compatible inference service. Keep credentials in this local file only.
CONTAINER_INFERENCE_BASE_URL=
CONTAINER_INFERENCE_MODEL=
CONTAINER_INFERENCE_API_KEY=
CONTAINER_INFERENCE_TIMEOUT_SECONDS=90

# Optional trusted Python adapter used by eval_run jobs.
# Leave blank until an operator has reviewed and configured an adapter.
CONTAINER_EVAL_PREDICTOR=
CONTAINER_EVAL_TIMEOUT_SECONDS=120
